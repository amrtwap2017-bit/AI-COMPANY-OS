  B
  C
  unrated
}

enum SupplierStatus {
  pending
  active
  suspended
  blacklisted
  rejected
}

enum SupplierDocType {
  trade_license
  vat_cert
  bank_details
  insurance
  profile
}

enum SupplierDocStatus {
  valid
  expired
  pending_renewal
}

enum WarehouseType {
  central
  site
  supplier
}

enum StockTransactionType {
  receipt
  issue
  transfer_out
  transfer_in
  adjustment
  return
}

enum InvoiceType {
  milestone
  manual
  credit_note
}

enum InvoiceStatus {
  draft
  sent
  overdue
  paid
  written_off
}

enum PaymentMethod {
