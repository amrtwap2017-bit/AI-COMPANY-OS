// ============================================================================
// Triangle Black Hospitality Engineering Operating System
// Prisma 6 Schema — PostgreSQL
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum TenantStatus {
  active
  suspended
  archived
}

enum UserRole {
  super_admin
  admin
  manager
  sales_rep
  engineer
  viewer
  client_admin
  client_user
}

enum AuditAction {
  create
  update
  delete
}

enum UnitCategory {
  length
  area
  count
  time
  weight
}

enum LeadSource {
  website
  referral
  event
  cold_outreach
  other
}

enum LeadStatus {
  new
  contacted
  qualified
  disqualified
  converted
}

enum OpportunityStage {
  qualification
  needs_analysis
  proposal
  negotiation
  closed_won
  closed_lost
}

enum CompanyStatus {
  active
  inactive
  prospect
}

enum CompanyType {
  hotel
  resort
  restaurant
  commercial
}

enum CompanyClassification {
  luxury
  midscale
  economy
  budget
}

enum ActivityType {
