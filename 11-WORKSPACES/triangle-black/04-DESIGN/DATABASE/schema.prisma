  folderId       String  @map("folder_id") @db.Uuid
  name           String  @db.VarChar(255)
  fileType       String  @map("file_type") @db.VarChar(20)
  fileSize       Int     @map("file_size")
  currentVersion Int     @default(1) @map("current_version")
  tags           String[] @db.Text
  description    String? @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String   @map("created_by") @db.Uuid
  updatedBy      String   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  folder   DocumentFolder    @relation(fields: [folderId], references: [id])
  versions DocumentVersion[]

  @@index([tenantId])
  @@index([folderId])
  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  version    Int
  filePath   String   @map("file_path") @db.VarChar(500)
  uploadedBy String   @map("uploaded_by") @db.Uuid
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

// ============================================================================
// AI COPILOTS
// ============================================================================

model AgentLog {
  id         String      @id @default(uuid()) @db.Uuid
  agentName  String      @map("agent_name") @db.VarChar(100)
  eventType  String      @map("event_type") @db.VarChar(100)
  input      Json?       @db.JsonB
  output     Json?       @db.JsonB
  confidence Decimal?    @db.Decimal(5, 2)
  executedAt DateTime    @map("executed_at") @db.Timestamptz
  durationMs Int         @map("duration_ms")
  status     AgentStatus
  error      String?     @db.Text
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([agentName])
  @@index([eventType])
  @@index([executedAt])
  @@index([status])
  @@map("agent_logs")
}

// ============================================================================
// INTEGRATIONS
// ============================================================================

model IntegrationConfig {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  provider   String   @db.VarChar(100)
  config     Json     @db.JsonB
  isActive   Boolean  @default(true) @map("is_active")
  lastSyncAt DateTime? @map("last_sync_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String   @map("created_by") @db.Uuid
  updatedBy  String   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId])
  @@index([provider])
  @@map("integration_configs")
}

model WebhookRegistration {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(255)
  url             String   @db.VarChar(500)
  events          String[] @db.Text
  secret          String   @db.VarChar(255)
  isActive        Boolean  @default(true) @map("is_active")
  lastDeliveredAt DateTime? @map("last_delivered_at") @db.Timestamptz
  failureCount    Int      @default(0) @map("failure_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String   @map("created_by") @db.Uuid
  updatedBy       String   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId])
  @@map("webhook_registrations")
}

model IntegrationLog {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  provider   String              @db.VarChar(100)
  direction  Direction
  status     IntegrationLogStatus
  request    Json?               @db.JsonB
  response   Json?               @db.JsonB
  error      String?             @db.Text
  executedAt DateTime            @map("executed_at") @db.Timestamptz
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([provider])
  @@index([direction])
  @@index([status])
  @@index([executedAt])
  @@map("integration_logs")
}

// ============================================================================
// MOBILE SYNC
// ============================================================================

model SyncLog {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  deviceId      String     @map("device_id") @db.VarChar(255)
  action        SyncAction
  recordsSynced Int        @default(0) @map("records_synced")
  conflicts     Int        @default(0)
  startedAt     DateTime   @map("started_at") @db.Timestamptz
  completedAt   DateTime?  @map("completed_at") @db.Timestamptz
  status        SyncStatus @default(in_progress)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@index([startedAt])
  @@map("sync_logs")
}

// ============================================================================
// HUMAN RESOURCES
// ============================================================================

model Department {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  parentId        String?  @map("parent_id") @db.Uuid
  name            String   @db.VarChar(100)
  code            String?  @db.VarChar(20)
  headEmployeeId  String?  @map("head_employee_id") @db.Uuid
  budgetHeadcount Int?     @map("budget_headcount")
  budgetSalary    Decimal? @map("budget_salary") @db.Decimal(12, 2)
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String   @map("created_by") @db.Uuid
  updatedBy       String   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentHierarchy")
  head      Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  employees Employee[]   @relation("EmployeeDepartment")

  @@unique([name, tenantId])
  @@index([tenantId])
  @@index([parentId])
  @@map("departments")
}

model Employee {
  id                       String         @id @default(uuid()) @db.Uuid
  tenantId                 String         @map("tenant_id") @db.Uuid
  departmentId             String         @map("department_id") @db.Uuid
  employeeCode             String         @map("employee_code") @db.VarChar(20)
  firstName                String         @map("first_name") @db.VarChar(100)
  lastName                 String         @map("last_name") @db.VarChar(100)
  nationalId               String?        @map("national_id") @db.VarChar(20)
  email                    String         @db.VarChar(255)
  phone                    String?        @db.VarChar(20)
  jobTitle                 String?        @map("job_title") @db.VarChar(100)
  employmentType           EmploymentType
  status                   EmployeeStatus @default(pending)
  hireDate                 DateTime       @map("hire_date") @db.Date
  terminationDate          DateTime?      @map("termination_date") @db.Date
  terminationReason        String?        @map("termination_reason") @db.Text
  salary                   Decimal?       @db.Decimal(12, 2)
  currency                 String?        @default("EGP") @db.VarChar(3)
  emergencyContactName     String?        @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone    String?        @map("emergency_contact_phone") @db.VarChar(20)
  emergencyContactRelation String?        @map("emergency_contact_relation") @db.VarChar(50)
  documents                Json?          @db.JsonB
  address                  String?        @db.Text
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")
  createdBy                String         @map("created_by") @db.Uuid
  updatedBy                String         @map("updated_by") @db.Uuid
  deletedAt                DateTime?      @map("deleted_at") @db.Timestamptz

  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  department        Department       @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  headOfDepartments Department[]     @relation("DepartmentHead")
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  timesheets        Timesheet[]
  attendanceRecords AttendanceRecord[]
  payrollRecords    PayrollRecord[]

  @@unique([employeeCode, tenantId])
  @@unique([email, tenantId])
  @@unique([nationalId])
  @@index([tenantId])
  @@index([departmentId])
  @@index([status])
  @@map("employees")
}

model LeaveRequest {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  employeeId      String            @map("employee_id") @db.Uuid
  leaveType       LeaveType
  startDate       DateTime          @map("start_date") @db.Date
  endDate         DateTime          @map("end_date") @db.Date
  totalDays       Decimal           @map("total_days") @db.Decimal(4, 1)
  reason          String            @db.Text
  status          LeaveRequestStatus @default(pending)
  approvedBy      String?           @map("approved_by") @db.Uuid
  approvedAt      DateTime?         @map("approved_at") @db.Timestamptz
  rejectionReason String?           @map("rejection_reason") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model LeaveBalance {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  employeeId  String          @map("employee_id") @db.Uuid
  year        Int
  leaveType   BalanceLeaveType
  totalDays   Decimal         @map("total_days") @db.Decimal(4, 1)
  usedDays    Decimal         @map("used_days") @db.Decimal(4, 1)
  carriedOver Decimal         @map("carried_over") @db.Decimal(4, 1)
  remaining   Decimal         @db.Decimal(4, 1)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, year, leaveType])
  @@index([tenantId])
  @@index([employeeId])
  @@map("leave_balances")
}

model Timesheet {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  employeeId    String          @map("employee_id") @db.Uuid
  projectId     String?         @map("project_id") @db.Uuid
  periodStart   DateTime        @map("period_start") @db.Date
  periodEnd     DateTime        @map("period_end") @db.Date
  sunHours      Decimal?        @map("sun_hours") @db.Decimal(4, 1)
  monHours      Decimal?        @map("mon_hours") @db.Decimal(4, 1)
  tueHours      Decimal?        @map("tue_hours") @db.Decimal(4, 1)
  wedHours      Decimal?        @map("wed_hours") @db.Decimal(4, 1)
  thuHours      Decimal?        @map("thu_hours") @db.Decimal(4, 1)
  totalHours    Decimal?        @map("total_hours") @db.Decimal(4, 1)
  overtimeHours Decimal?        @map("overtime_hours") @db.Decimal(4, 1)
  taskCategory  String?         @map("task_category") @db.VarChar(50)
  description   String?         @db.Text
  status        TimesheetStatus @default(draft)
  approvedBy    String?         @map("approved_by") @db.Uuid
  approvedAt    DateTime?       @map("approved_at") @db.Timestamptz
  hourlyRate    Decimal?        @map("hourly_rate") @db.Decimal(10, 2)
  laborCost     Decimal?        @map("labor_cost") @db.Decimal(12, 2)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  project  Project? @relation(fields: [projectId], references: [id])

  @@index([tenantId])
  @@index([employeeId, periodStart])
  @@index([projectId])
  @@index([status])
  @@map("timesheets")
}

model AttendanceRecord {
  id                     String           @id @default(uuid()) @db.Uuid
  tenantId               String           @map("tenant_id") @db.Uuid
  employeeId             String           @map("employee_id") @db.Uuid
  date                   DateTime         @db.Date
  checkIn                DateTime         @map("check_in") @db.Timestamptz
  checkOut               DateTime?        @map("check_out") @db.Timestamptz
  totalHours             Decimal?         @map("total_hours") @db.Decimal(4, 1)
  status                 AttendanceStatus
  lateMinutes            Int?             @map("late_minutes")
  earlyDepartureMinutes  Int?             @map("early_departure_minutes")
  gpsCheckIn             Json?            @map("gps_check_in") @db.JsonB
  gpsCheckOut            Json?            @map("gps_check_out") @db.JsonB
  notes                  String?          @db.Text
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  createdBy              String           @map("created_by") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([tenantId])
  @@index([employeeId, date])
  @@index([date])
  @@map("attendance_records")
}

model PayrollRecord {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  periodMonth     Int           @map("period_month")
  periodYear      Int           @map("period_year")
  basicSalary     Decimal       @map("basic_salary") @db.Decimal(12, 2)
  allowances      Decimal       @default(0) @db.Decimal(12, 2)
  deductions      Decimal       @default(0) @db.Decimal(12, 2)
  overtimePay     Decimal       @default(0) @map("overtime_pay") @db.Decimal(12, 2)
  leaveDeductions Decimal       @default(0) @map("leave_deductions") @db.Decimal(12, 2)
  socialInsurance Decimal       @default(0) @map("social_insurance") @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  netPay          Decimal       @map("net_pay") @db.Decimal(12, 2)
  status          PayrollStatus @default(draft)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, periodMonth, periodYear])
  @@index([tenantId])
  @@index([employeeId, periodMonth, periodYear])
  @@index([status])
  @@map("payroll_records")
}
