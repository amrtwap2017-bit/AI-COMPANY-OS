# ============================================================
# TRIANGLE BLACK — PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================
# Copy to: /etc/triangle-black/.env.prod
# NEVER commit this file with real values to git
# NEVER share this file in prompts or documentation
# ============================================================

# === DATABASE [REQUIRED] ===
POSTGRES_USER=tb_prod                    # Production DB username
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PW   # ROTATE: use 32+ char random string
POSTGRES_DB=triangle_black_prod          # Production DB name
POSTGRES_HOST=db                         # Docker service name
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://tb_prod:CHANGE_ME_STRONG_PW@db:5432/triangle_black_prod

# === AUTHENTICATION [REQUIRED] ===
TB_SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM   # ROTATE: use openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === REDIS [REQUIRED] ===
REDIS_URL=redis://:CHANGE_ME_REDIS_PW@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PW

# === APPLICATION [REQUIRED] ===
ENVIRONMENT=production
DEBUG=false
LOG_FORMAT=json
LOG_LEVEL=INFO

# === DOMAIN [REQUIRED] ===
ALLOWED_ORIGINS=https://app.triangleblack.com,https://www.triangleblack.com
NEXT_PUBLIC_API_URL=https://app.triangleblack.com
API_URL=https://app.triangleblack.com/api/v1

# === RATE LIMITING [REQUIRED] ===
ENABLE_TENANT_RATE_LIMIT=1
TENANT_RATE_LIMIT_MAX=500
DISABLE_RATE_LIMIT=0

# === ALERTS [OPTIONAL] ===
# Set to enable P0 alert delivery
ALERT_WEBHOOK_URL=                       # Telegram/Slack/Discord webhook URL
ALERT_EMAIL_TO=                          # Alert recipient email
ALERT_EMAIL_FROM=                        # Sender email
ALERT_SMTP_HOST=                         # SMTP server
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=

# === BACKUP [OPTIONAL] ===
BACKUP_DIR=/app/backups
MAX_BACKUP_AGE_HOURS=25
RCLONE_REMOTE=                           # e.g., b2:triangle-black-backups

# === NEXTJS [REQUIRED] ===
NODE_ENV=production
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET  # ROTATE: openssl rand -hex 32
NEXTAUTH_URL=https://app.triangleblack.com

# === AI ENGINE [OPTIONAL] ===
AI_ENGINE_URL=                           # Ollama URL if using local AI
