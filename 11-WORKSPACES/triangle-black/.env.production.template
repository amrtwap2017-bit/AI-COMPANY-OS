# Triangle Black — Production Environment Template
# Copy to .env.production and fill in real values
# NEVER commit .env.production to git

# Database
DATABASE_URL=postgresql+psycopg2://tb_user:CHANGE_ME@postgres:5432/triangle_black
POSTGRES_USER=tb_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=triangle_black

# Auth
TB_SECRET_KEY=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis
REDIS_URL=redis://redis:6379/0

# Rate limiting
DISABLE_RATE_LIMIT=0
RATE_LIMIT_MAX=100
TENANT_RATE_LIMIT_MAX=300
ENABLE_TENANT_RATE_LIMIT=1

# AI
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ETA (Egypt Tax Authority)
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_ENV=sandbox

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Portal
NEXT_PUBLIC_API_URL=http://backend:8030
NEXT_PUBLIC_AUTH_BYPASS=false
