FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install uv

# Copy dependency files
COPY pyproject.toml uv.lock* ./

# Install dependencies
RUN uv pip install --system -r pyproject.toml 2>/dev/null || \
    uv pip install --system fastapi uvicorn sqlalchemy psycopg2-binary \
    python-jose bcrypt python-multipart reportlab python-dateutil

# Copy source
COPY src/ ./src/
COPY alembic/ ./alembic/
COPY alembic.ini ./

# Run migrations then start
CMD ["sh", "-c", "uvicorn src.main:app --host 0.0.0.0 --port 8020"]
