{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next/dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "app/(app)/(enterprise)/commercial/page.tsx",
    "app/(app)/(enterprise)/customers/[id]/page.tsx",
    "app/(app)/(enterprise)/engineering/page.tsx",
    "app/(app)/(enterprise)/executive/page.tsx",
    "app/(app)/(enterprise)/maintenance/page.tsx",
    "app/(app)/(enterprise)/operations/page.tsx",
    "app/(app)/(enterprise)/supply-chain/page.tsx",
    "app/(app)/(enterprise)/supply-chain/rfqs/page.tsx",
    "app/(app)/(enterprise)/workspace/page.tsx",
    "app/(app)/contracts/[id]/page.tsx",
    "app/(app)/inventory/items/page.tsx",
    "app/(app)/inventory/purchase-orders/page.tsx",
    "app/(app)/inventory/purchase-requests/page.tsx",
    "app/(app)/inventory/vendors/page.tsx",
    "app/(app)/inventory/warehouses/page.tsx",
    "app/(app)/quotes/[id]/page.tsx",
    "app/(app)/reports/page.tsx"
  ]
}