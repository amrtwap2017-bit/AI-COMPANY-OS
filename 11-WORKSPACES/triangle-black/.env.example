# Triangle Black — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://tb_user:tb_pass@localhost:5434/triangle_black
TRIANGLE_BLACK_DB_URL=postgresql://tb_user:tb_pass@localhost:5434/triangle_black
POSTGRES_URL=postgresql://tb_user:tb_pass@localhost:5434/triangle_black

# ── Authentication ─────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
TB_SECRET_KEY=CHANGE-ME-generate-with-secrets-token-hex-64
SECRET_KEY=CHANGE-ME-generate-with-secrets-token-hex-64
JWT_SECRET_KEY=CHANGE-ME-generate-with-secrets-token-hex-64
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Environment ────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# ── AI Services ───────────────────────────────────────────────────────────
AI_ENGINE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Email (optional) ──────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── ETA E-Invoicing (Egypt) ───────────────────────────────────────────────
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=

# ── Rate Limiting ─────────────────────────────────────────────────────────
# Set to 1 in development to disable rate limiting for tests
DISABLE_RATE_LIMIT=0

# ── Redis (optional — falls back to in-memory cache) ─────────────────────
REDIS_URL=redis://localhost:6379/0
