# Triangle Black — Environment Configuration Template
# Copy this file to .env.local for development
# NEVER put real credentials in this file
# NEVER commit .env.local or .env.production to git

# ── Backend API ──────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
TB_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_64

# PostgreSQL connection string
# Development: postgresql+psycopg2://USER:PASS@localhost:5432/DBNAME
DATABASE_URL=postgresql+psycopg2://CHANGE_ME_user:CHANGE_ME_password@localhost:5432/triangle_black

# Environment: development | staging | production
ENVIRONMENT=development

# Rate limiting (0=disabled for dev, 1=enabled for prod)
DISABLE_RATE_LIMIT=1
ENABLE_TENANT_RATE_LIMIT=0

# ── Portal ────────────────────────────────────────────────────────────────────
# URL of the backend API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8030

# Demo credentials (ONLY for development — leave empty for production)
# These prefill the login form in dev mode only
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_DIR=./backups
# PGPASSWORD is set automatically from DATABASE_URL in production

# ── Email (optional) ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@triangleblack.com

# ── AI (optional) ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Security ─────────────────────────────────────────────────────────────────
# Same as TB_SECRET_KEY — used for JWT signing
JWT_SECRET_KEY=CHANGE_ME_same_as_tb_secret_key
JWT_ALGORITHM=HS256

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8030

# ── AI Engine ─────────────────────────────────────────────────────────────────
# Local AI engine URL (Ollama or compatible)
AI_ENGINE_URL=http://localhost:11434
