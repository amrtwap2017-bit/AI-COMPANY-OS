#!/usr/bin/env bash
set -euo pipefail

PASS=0
FAIL=0
SKIP=0
WARN=0

ROOT="$(pwd)"
TB_DIR="${ROOT}/11-WORKSPACES/triangle-black"
TB_VENV="${TB_DIR}/.venv"
TB_PYTEST="${TB_VENV}/bin/python"

echo "╔══════════════════════════════════════╗"
echo "║      VERIFICATION ENGINE v3          ║"
echo "╚══════════════════════════════════════╝"
echo "  Root   : $ROOT"
echo "  TB Dir : $TB_DIR"
echo ""

run_gate() {
  local gate="$1"
  local cmd="$2"
  local dir="${3:-$ROOT}"
  echo "── GATE: $gate"
  if (cd "$dir" && eval "$cmd") 2>&1 | tail -15; then
    echo "  ✓ PASSED: $gate"
    PASS=$((PASS+1))
  else
    echo "  ✗ FAILED: $gate"
    FAIL=$((FAIL+1))
  fi
  echo ""
}

warn_gate() {
  local gate="$1"
  local cmd="$2"
  local dir="${3:-$ROOT}"
  echo "── GATE [WARN]: $gate"
  (cd "$dir" && eval "$cmd") 2>&1 | tail -10 || true
  echo "  ⚠ WARNING (non-blocking): $gate"
  WARN=$((WARN+1))
  echo ""
}

skip_gate() {
  echo "── GATE: $1 — SKIPPED (${2})"
  SKIP=$((SKIP+1))
  echo ""
}

# ── TRIANGLE BLACK BACKEND ────────────────────────────────────
echo "── BACKEND CHECKS ──────────────────────────────────────"

if [ -x "${TB_VENV}/bin/python" ]; then
  run_gate "TB: pytest (unit, no live_http)" \
    "${TB_VENV}/bin/python -m pytest tests/ -q --tb=short -m 'not live_http' 2>&1 | tail -20" \
    "${TB_DIR}"
else
  skip_gate "TB: pytest" "venv python not found at ${TB_VENV}/bin/python"
fi

if [ -x "${TB_VENV}/bin/ruff" ]; then
  run_gate "TB: Ruff lint" \
    "${TB_VENV}/bin/ruff check . 2>&1 | tail -10" \
    "${TB_DIR}"
elif command -v ruff &>/dev/null; then
  run_gate "TB: Ruff lint (system)" \
    "ruff check ${TB_DIR} --exclude .venv --exclude __pycache__ 2>&1 | tail -10"
else
  skip_gate "TB: Ruff lint" "ruff not found"
fi

# ── FRONTEND CHECKS ───────────────────────────────────────────
echo ""
echo "── FRONTEND CHECKS ─────────────────────────────────────"

for portal_dir in \
  "${ROOT}/11-WORKSPACES/triangle-black/portal" \
  "${ROOT}/11-WORKSPACES/triangle-black/client-portal" \
  "${ROOT}/11-WORKSPACES/triangle-black/admin-portal" \
  "${ROOT}/11-WORKSPACES/triangle-black-frontend"; do

  short_name="$(basename $portal_dir)"
  if [ -f "${portal_dir}/package.json" ]; then
    echo "  Found frontend: $short_name"
    if [ -f "${portal_dir}/node_modules/.bin/tsc" ]; then
      # portal has known pre-existing TS bugs — treat as WARN not FAIL
      if [ "$short_name" = "portal" ]; then
        warn_gate "TS [KNOWN-ISSUES]: $short_name" \
          "node_modules/.bin/tsc --noEmit 2>&1 | tail -10" \
          "${portal_dir}"
      else
        run_gate "TS: $short_name" \
          "node_modules/.bin/tsc --noEmit 2>&1 | tail -10" \
          "${portal_dir}"
      fi
    else
      skip_gate "TS: $short_name" "tsc not installed (run npm install)"
    fi
  fi
done

# ── GIT SAFETY ────────────────────────────────────────────────
echo ""
echo "── GIT SAFETY ──────────────────────────────────────────"
DIRTY=$(git -C "$ROOT" status --short 2>/dev/null | wc -l | tr -d '[:space:]')
if [ "${DIRTY}" = "0" ]; then
  echo "  ✓ PASS — Working tree clean"
  PASS=$((PASS+1))
else
  echo "  ⚠ WARNING — ${DIRTY} uncommitted changes"
  WARN=$((WARN+1))
fi

echo ""
echo "══════════════════════════════════════════"
echo "  PASSED  : $PASS"
echo "  FAILED  : $FAIL"
echo "  WARNED  : $WARN (non-blocking)"
echo "  SKIPPED : $SKIP"
echo ""

if [ "${FAIL}" -gt 0 ]; then
  echo "RESULT: ✗ VERIFICATION FAILED — fix failures before commit"
  exit 1
else
  echo "RESULT: ✓ VERIFICATION PASSED (${WARN} warnings, ${SKIP} skipped)"
  exit 0
fi
