#!/usr/bin/env bash
set -euo pipefail

TASK_ID="${1:-UNKNOWN}"
STATUS="${2:-COMPLETE}"
TIMESTAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
COMMIT="$(git rev-parse --short HEAD 2>/dev/null || echo NO_COMMIT)"
OUTFILE=".ai/reports/checkpoints/CHECKPOINT-${TASK_ID}-${TIMESTAMP//[:]/-}.md"

echo "Creating checkpoint: $TASK_ID | $STATUS | $COMMIT"

{
echo "# CHECKPOINT"
echo ""
echo "## Metadata"
echo "| Field | Value |"
echo "|-------|-------|"
echo "| Task | $TASK_ID |"
echo "| Status | $STATUS |"
echo "| Timestamp | $TIMESTAMP |"
echo "| Commit | $COMMIT |"
echo ""
echo "## Files Changed"
git diff --name-only HEAD 2>/dev/null || echo "No git diff available"
echo ""
echo "## Git Status"
git status --short 2>/dev/null || echo "No git status"
echo ""
echo "## Next Steps"
echo "See .ai/state/project-state.json next_actions"
} > "$OUTFILE"

cp "$OUTFILE" .ai/reports/checkpoints/LATEST.md

# Update project-state.json
python3 - << PYEOF
import json
from pathlib import Path
from datetime import datetime, timezone

def now():
    return datetime.now(timezone.utc).isoformat()

state_file = Path(".ai/state/project-state.json")
try:
    s = json.loads(state_file.read_text())
    s["last_checkpoint"] = "$TIMESTAMP"
    s["last_commit"] = "$COMMIT"
    s["last_updated"] = now()
    if "$STATUS" == "COMPLETE":
        s["active_task"] = None
    state_file.write_text(json.dumps(s, indent=2))
    print("  project-state.json updated")
except Exception as e:
    print(f"  project-state.json ERROR: {e}")

sprint_file = Path(".ai/state/sprint-state.json")
try:
    s = json.loads(sprint_file.read_text())
    s["checkpoint_created"] = True
    sprint_file.write_text(json.dumps(s, indent=2))
    print("  sprint-state.json updated")
except Exception as e:
    print(f"  sprint-state.json ERROR: {e}")
PYEOF

# Auto-stage all .ai/ runtime files
echo ""
echo "── Staging .ai/ runtime files..."
git add \
  .ai/state/ \
  .ai/reports/checkpoints/LATEST.md \
  .ai/reports/checkpoints/"$(basename "$OUTFILE")" \
  .ai/context/ \
  .ai/sessions/ \
  .ai/memory/ \
  .ai/sprints/ \
  .ai/tasks/ \
  2>/dev/null || true

STAGED=$(git diff --cached --name-only 2>/dev/null | wc -l | tr -d '[:space:]')
echo "  Staged: $STAGED files"
echo ""
echo "Checkpoint written: $OUTFILE"
echo "LATEST.md updated."
echo ""
echo "Next: git commit -F /tmp/commit-msg.txt"
